# ─────────────────────────────────────────────
# 달디단 (Daldidan) — 환경 변수 템플릿
# 이 파일을 복사해 .env.local 로 저장한 후 값을 채우세요.
# ─────────────────────────────────────────────

# 사이트 기본 URL (이메일 링크, 알림톡 딥링크 등에 사용)
# 프로덕션에서는 실제 공개 도메인을 반드시 넣으세요.
# 예: https://daldidan.vercel.app  또는 로컬: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# ── Firebase Cloud Messaging (웹 푸시) ────────────────────────
# Firebase Console > 프로젝트 설정 > 일반 / Cloud Messaging 에서 확인
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 서버 전용 Firebase Admin 자격 증명
# 둘 중 하나를 사용하세요.
# 1) 개별 필드 3개
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
# 2) 서비스 계정 JSON 전체 문자열 1개
FIREBASE_ADMIN_CREDENTIALS_JSON=

# ── Supabase ──────────────────────────────────
# https://supabase.com/dashboard/project/_/settings/api 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=     # 서버 전용 — 절대 클라이언트에 노출 금지

# ── Google Maps ───────────────────────────────
# https://console.cloud.google.com/apis/credentials 에서 발급
# Vision API 활성화 필요 (영수증 OCR 전용)
GOOGLE_MAPS_API_KEY=

# ── NAVER Search / Reverse Geocoding ─────────
# NAVER Developers 검색 API + NAVER Cloud Maps Reverse Geocoding 사용
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── NAVER Maps (블로그 지도 삽입) ─────────────
# 블로그 에디터의 지도 삽입은 URL 붙여넣기 방식으로 동작하므로 별도 키 불필요.
# map.naver.com 또는 naver.me 링크를 붙여넣으면 자동으로 반응형 iframe으로 변환됨.

# ── NAVER CLOVA OCR Receipt ───────────────────
# NAVER Cloud Platform > CLOVA OCR > Document 도메인(Receipt) 생성 후 확인
# Invoke URL은 APIGW 자동 연동으로 발급된 Receipt용 주소를 그대로 사용하세요.
# Secret Key는 도메인 상세에서 확인할 수 있습니다.
NAVER_CLOVA_OCR_INVOKE_URL=
NAVER_CLOVA_OCR_SECRET_KEY=

# ── 부동산 실거래 (국토교통부 공공데이터포털) ──
# https://www.data.go.kr 에서 '아파트 매매 실거래가' API 활용 신청 후 발급
# 미설정 시 부동산 위젯이 예시(mock) 데이터로 동작
REALESTATE_API_KEY=
# 조회 지역 법정동 코드 (쉼표 구분, 미설정 시 서울 주요 10개 구)
REALESTATE_REGION_CODE=

# ── 카카오 Maps / SDK ────────────────────────
# https://developers.kakao.com → 앱 생성 → 앱 키 에서 확인
# REST API 키: 블로그 지도 삽입 장소 검색 (서버 전용)
KAKAO_REST_API_KEY=
# JavaScript 키: 블로그 카카오 공유 버튼 (미설정 시 버튼 비활성화)
NEXT_PUBLIC_KAKAO_JS_KEY=

# ── 카카오 알림톡 (선택) ──────────────────────
# https://business.kakao.com 에서 비즈니스 채널 등록 후 발급
# 미설정 시 알림톡 발송 스킵 (에러 없음)
KAKAO_ALIMTALK_API_KEY=
KAKAO_ALIMTALK_SENDER=
KAKAO_ALIMTALK_TEMPLATE=

# ── Resend (블로그 발행 이메일 알림) ──────────
# https://resend.com/api-keys 에서 발급
# 미설정 시 이메일 알림 스킵 (에러 없음)
RESEND_API_KEY=
RESEND_FROM_EMAIL=   # 예: 달디단 <noreply@yourdomain.com>

# ── Anthropic (블로그 AI 요약) ─────────────────
# https://console.anthropic.com 에서 발급
# 미설정 시 규칙 기반 폴백 요약으로 동작
ANTHROPIC_API_KEY=
# 요약 모델 (미설정 시 기본값 claude-haiku-4-5-20251001)
ANTHROPIC_BLOG_SUMMARY_MODEL=

# ── 블로그 썸네일 생성 ────────────────────────
# Magnific AI (1순위) — 한도 초과 시 Unsplash 폴백
MAGNIFIC_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── 댓글 비밀번호 보안 ────────────────────────
# HMAC-SHA256 시크릿 키 (랜덤 32자 이상 문자열 권장)
# 미설정 시 기본값 사용 — 프로덕션에서는 반드시 설정할 것
COMMENT_PASSWORD_SECRET=

# ── Vercel Cron 보호 토큰 ─────────────────────
# 로또 크롤러(/api/lotto/crawl)·일정 리마인드(/api/calendar/remind) 크론 인증.
# 미설정 시 두 엔드포인트가 인증 없이 열리므로 프로덕션에서는 반드시 설정하고
# Vercel 프로젝트 환경변수에도 동일하게 등록할 것.
CRON_SECRET=

# ── WebAuthn (생체 인증 로그인) ────────────────
# 미설정 시 배포 도메인 기준 기본값 사용
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
NEXT_PUBLIC_APP_NAME=

# ── 로또 (동행복권 공개 API — 별도 키 불필요) ──────────────────
# 동행복권 API: https://www.dhlottery.co.kr/common.do?method=getLottoNumber
# 차단 시 네이버 검색 크롤링 폴백 — 서버사이드 Route Handler에서 직접 fetch

# ── 국내 증권 (한국거래소 KRX Open API + 네이버 시세 보강) ─────
# KRX Data Marketplace에서 인증키와 서비스별 이용 승인을 받은 뒤 입력하세요.
# 사용 서비스: 유가증권/코스닥/코넥스 일별매매정보, 종목기본정보
# 실시간 보강 시세는 네이버 모바일 증권 공개 API(키 불필요)로 병합됩니다.
# ⚠️ KRX 키가 없으면 위젯이 "미설정" 상태로 표시됩니다 (네이버 단독 동작 안 함).
KRX_OPENAPI_KEY=
# 기본값: https://data-dbg.krx.co.kr
KRX_OPENAPI_BASE_URL=
# 첫 로드 기본 관심종목 (6자리 코드, 쉼표 구분)
KRX_DEFAULT_SYMBOLS=005930,000660,035420,005380

# ── Cloudflare Stream (블로그 동영상 스트리밍) ───────────────
# API Token 권한: Stream Write, Stream Read
# customer code는 playback URL의 customer-<CODE> 부분입니다.
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER_CODE=
# 업로드 시 예약할 최대 영상 길이(초)
CLOUDFLARE_STREAM_MAX_DURATION_SECONDS=3600
# 플레이어 포스터 추출 시점
NEXT_PUBLIC_CLOUDFLARE_STREAM_POSTER_TIME=1s
